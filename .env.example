# VOIDLINE - environment template
#
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit
# credentials. Nothing in the codebase may hard-code a production URL or secret.
#
#   cp .env.example .env
#
# The web workspace reads only NEXT_PUBLIC_* values (they are compiled into the
# browser bundle, so never put a secret behind that prefix). Everything else is
# server-only.

# ----------------------------------------------------------------- web (client)
# Base URL of the REST API, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Base URL of the Socket.IO server. Usually the same origin as the API.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --------------------------------------------------------------------- server
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS. Must include the web app's origin.
CORS_ORIGINS=http://localhost:3000
# Where password-reset links point. The web client's origin.
WEB_APP_URL=http://localhost:3000

# ------------------------------------------------------------------- database
MONGODB_URI=mongodb://127.0.0.1:27017/voidline

# ----------------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

# ---------------------------------------------------------------------- redis
# Optional in development. Required once more than one server instance runs:
# without it, two instances cannot see each other's rooms. See DEPLOYMENT.md.
REDIS_URL=

# ---------------------------------------------------------------------- voice
# none | livekit | agora | daily | webrtc   (see the voice provider abstraction)
VOICE_PROVIDER=none
VOICE_API_KEY=
VOICE_API_SECRET=
VOICE_SERVER_URL=

# ----------------------------------------------------------------------- mail
# Used for password reset. With no host configured the server logs reset links
# to the console in development instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@voidline.local
