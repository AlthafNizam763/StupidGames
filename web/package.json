{
  "name": "@voidline/web",
  "version": "0.1.0",
  "private": true,
  "description": "VOIDLINE web client: Next.js App Router UI plus a Canvas game renderer.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test NEXT_PUBLIC_API_URL=http://localhost:4000 NEXT_PUBLIC_SOCKET_URL=http://localhost:4000 node --import tsx --experimental-test-module-mocks --test \"game/**/*.test.ts\" \"stores/**/*.test.ts\" \"lib/**/*.test.ts\""
  },
  "dependencies": {
    "@voidline/shared": "*",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
